# EduTrack Pro — Root .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — NEVER commit real secrets
.env
.env.*
!.env.example

# Build artifacts
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# Test artifacts
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp

