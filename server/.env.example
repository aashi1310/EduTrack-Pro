PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=edutrack
DB_CONNECTION_LIMIT=20

# Authentication — MUST be a long random secret in production
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# For production, add your deployed Vercel URL, e.g.:
#   CLIENT_URL=http://localhost:5174,https://edutrack-pro.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
